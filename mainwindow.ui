  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #f5f5f5;
}

QLabel#welcomeLabel {
    font-size: 32px;
    font-weight: bold;
    color: #2c3e50;
}

QLabel#sectionLabel {
    font-size: 20px;
    font-weight: bold;
    color: #2c3e50;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #21618c;
}

QFrame#sidebar {
    background-color: #2c3e50;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
}

QFrame#statsCard {
    background-color: white;
    border-radius: 15px;
    padding: 20px;
    border: 2px solid #ecf0f1;
}

QFrame#questionCard {
    background-color: white;
    border-radius: 20px;
    padding: 30px;
    border: 3px solid #3498db;
}

QLabel#questionLabel {
    font-size: 24px;
    color: #2c3e50;
    padding: 20px;
    font-weight: bold;
}

QLabel#wordLabel {
    font-size: 36px;
    color: #e74c3c;
    padding: 20px;
    font-weight: bold;
}

QLabel#feedbackLabel {
    font-size: 18px;
    padding: 15px;
    border-radius: 10px;
}</string>
